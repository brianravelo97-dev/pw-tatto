# URL pública del sitio (SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com

# WhatsApp del estudio en formato internacional, solo dígitos (ej: 56912345678).
# Si se deja vacío, el botón de WhatsApp no se muestra y se prioriza Instagram.
NEXT_PUBLIC_WHATSAPP=

# Correo de contacto (opcional)
NEXT_PUBLIC_EMAIL=

# Dirección del estudio (opcional)
NEXT_PUBLIC_ADDRESS=

# Webhook que recibe las consultas del formulario (JSON por POST).
# Compatible con Make, Zapier, n8n, Formspree, Google Apps Script, etc.
CONTACT_WEBHOOK_URL=
